# Put a freshly rotated BotFather token in Replit Secrets or your hosting provider's secrets.
TELEGRAM_BOT_TOKEN=

# The bot initially checks the @nawron username. Set ADMIN_ID after sending /id
# to the bot for stronger account-level authorization.
ADMIN_USERNAME=nawron
ADMIN_ID=

# SQLite file path (use persistent storage on your host).
DATABASE_PATH=support_bot.sqlite3
LOG_LEVEL=INFO
